# Supabase (Settings → API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase CLI (pnpm db:types)
SUPABASE_PROJECT_ID=<project-ref>

# Metadata providers (Phase 3 — the app must not crash when these are absent)
TMDB_READ_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Bot protection on sign-in (Cloudflare Turnstile site key; public. The secret goes in the Supabase dashboard)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
